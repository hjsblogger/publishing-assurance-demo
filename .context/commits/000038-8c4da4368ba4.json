{"seq":38,"prev_hash":"sha256:899d4ae969b00d8c756acac4e3e918016d02d7372e2fb3f29d931b15c299cafd","ts":"2026-09-18T06:56:02.581Z","proposal_id":null,"nodes":[{"cid":"sha256:a2c90cb5d8f8cc5a548ba6e5e4a8aa9f48c52d68bd7fa264702589e28f2c8766","label":"ac","content":{"text":"After the current session's only tracked submission is withdrawn, the `My Submissions (N)` header shows `My Submissions (0)`.","kind":"absolute","risk":"med","derived":true,"expected_answer":{"operator":"equals","operand":"My Submissions (0)"}}},{"cid":"sha256:bf68493c30812feb37cc938224476d37d40a57b0748331d00898c16639f05c5f","label":"ac","content":{"text":"In a different browser session, `/my-submissions` does not show the `SUB-` reference created in the original browser session.","kind":"forbidden-presence","risk":"med","derived":true,"expected_answer":{"operator":"exists","operand":"the submission reference created in the original browser session appears in the different browser session's `/my-submissions` view"}}},{"cid":"sha256:9e22f979b7793f36b06145a0227fd592fd1f04f93b8b767eaa97ddbdace60fbf","label":"ac","content":{"text":"After a successful submission, `/my-submissions` shows a row for the manuscript that was just submitted.","kind":"presence","risk":"med","derived":true,"expected_answer":{"operator":"exists","operand":"a `/my-submissions` row whose Book Title, Author, Package, and Seat values identify the manuscript just submitted"}}}],"edges":[{"ecid":"sha256:0d277da0e35d8bc48f82cc4f0410b5c292a53fd9f5fa689de743f939fdae2dae","type":"scoped_to","src":"sha256:a2c90cb5d8f8cc5a548ba6e5e4a8aa9f48c52d68bd7fa264702589e28f2c8766","dst":"sha256:0cf96f64f53cc4eb9aac41505db3831952a4f686c9a7d2e7f66e8eb23e74c39a","props":{}},{"ecid":"sha256:52489f0082b4e2371facb34853edd4b029a19d5e710f4a1d7c657935b31a3ee0","type":"scoped_to","src":"sha256:bf68493c30812feb37cc938224476d37d40a57b0748331d00898c16639f05c5f","dst":"sha256:dcef7cc7d341a49ef9972bfa92b69a29f4f6e0dd90e24add058dd7e0f8e27579","props":{}},{"ecid":"sha256