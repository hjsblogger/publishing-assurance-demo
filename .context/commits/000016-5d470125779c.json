56:0ee8392881a0d3a3376423544c257dd6b4e89a39baa8a4f1c5ac0f3a67abeed0","slug":"ac-55","by":{"kind":"ai","id":"design-agent"}}],"judgements":[{"about":"sha256:8068fe2d94d3ff6f128a06aae0672d49638b147bc23a9124852c34357da1172f","rationale":"[risk_factors] Applied user-reach and change-frequency because this public landing-page route affects every visitor entering the publishing flow and homepage routing commonly changes during content iteration; did not apply auth or data-loss because the page is anonymous and read-only.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:e6a9434ce847312515adb7ce791fbb9a4c7b47e38c6f9ff8e04be784c5c50ad7","rationale":"[risk_factors] Applied money and user-reach because package pricing is a commercial promise shown to every prospective author on the public home page; did not apply auth or data-loss because no protected or mutable state is involved.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:0d31e91db002b517f8b5a165f0fc82c04a7b4e01bb3e48bc353c7f5a1de62639","rationale":"[risk_factors] Applied user-reach and change-frequency because this public route is a primary publishing navigation choice exposed to all visitors and is prone to homepage CTA updates.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:45c4cc9d103b46934fb570fa63d58e10ac94aef90e19e986b66e10249babd4e7","rationale":"[risk_factors] Applied user-reach and change-frequency because this public catalog route is exposed to all visitors and homepage outbound links are common content-touch points.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:a7711ee162f1c9bb62cb8838e83f34769f08789573f0f81900e96a0e865c3f9d","rationale":"[risk_factors] Applied user-reach because every visitor relies on the package preview set to understand the publishing offer; did not apply money because the count itself is structural rather than a monetary figure.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:fe44a467739b2358777a552c5382fe2f11ddf27949aa377b0b0f9770a4d227f5","rationale":"[risk_factors] Applied user-reach because package names are essential orientation content for every prospective author viewing the landing page.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:4fd4dd801dc73e4da167847da3816810814202b5ed68860ea7c241c123a3814d","rationale":"[risk_factors] Applied user-reach because taglines are public discovery content that shapes package selection, but not money because the promise is descriptive rather than a numeric commercial term.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:cead86aa5cb5c3acb8289f306534c8fbfe708a82e0906320a5c869be772554c2","rationale":"[risk_factors] Applied user-reach because every public visitor needs the preview links to continue into package exploration from the home page.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:ce17737b5d22b6c040a65ce3ddc2c667bb3a46c22c642fb4cf0030d7f816239f","rationale":"[risk_factors] Applied user-reach and change-frequency because the recent-books showcase is public discovery content and its membership changes as the catalog changes.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:8ba099d7ffce884c7083b5057e10c605ad13c5313a2a61b17b05b12953089df2","rationale":"[risk_factors] Applied user-reach and change-frequency because broken recent-book title links strand public readers and the showcased books can rotate over time.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:94a72208c8c03bdb83d88dfa133ae1a06764d078648d32c0e4e5fc269a0b444d","rationale":"[risk_factors] Applied user-reach and change-frequency because the catalog-size statement is a public credibility claim whose value changes as more books are published.","by":{"kind":"ai","id":"design-agent"}},{"about":"sha256:0ee8392881a0d3a3376423544c257dd6b4e89a39baa8a4f1c5ac0f3a67abeed0","rationale":"[risk_factors] Applied user-reach because the main heading is the first public orientation cue on the landing page.","by":{"kind":"ai","id":"design-agent"}}],"design_of":{"u